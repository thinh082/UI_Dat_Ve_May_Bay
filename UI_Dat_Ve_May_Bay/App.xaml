<Application x:Class="UI_Dat_Ve_May_Bay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Vietnam Airlines Color Palette & Modern Tokens -->
        <SolidColorBrush x:Key="VnaPrimaryBlue" Color="#00548B"/>
        <SolidColorBrush x:Key="VnaSecondaryTeal" Color="#008291"/>
        <SolidColorBrush x:Key="VnaGold" Color="#D4AF37"/>
        <SolidColorBrush x:Key="VnaLightBlue" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="VnaBorderGray" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="VnaTextDark" Color="#111827"/>
        <SolidColorBrush x:Key="VnaTextGray" Color="#6B7280"/>
        
        <!-- Premium Tokens -->
        <SolidColorBrush x:Key="SidebarBg" Color="#004675"/>
        <SolidColorBrush x:Key="SidebarActive" Color="#1AFFFFFF"/>
        <DropShadowEffect x:Key="PremiumShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.12" Color="#001A36"/>
        <DropShadowEffect x:Key="GlassShadow" BlurRadius="10" ShadowDepth="1" Opacity="0.05" Color="Black"/>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SideNavButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BEE3F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <!-- Active Indicator Dot -->
                                <Ellipse x:Name="Indicator" Fill="{StaticResource VnaGold}" Width="6" Height="6" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#10FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style button cho top nav (Legacy) -->
        <Style x:Key="TopNavButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0EEFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VnaPrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="{StaticResource VnaPrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Application.Resources>
</Application>
