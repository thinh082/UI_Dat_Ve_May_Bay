<Window x:Class="UI_Dat_Ve_May_Bay.DangKy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI_Dat_Ve_May_Bay"
        mc:Ignorable="d"
        Title="Đăng Ký - Parador" 
        Height="600" 
        Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="40,12,12,12"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="40,12,40,12"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Branding -->
        <Grid Grid.Column="0">
            <!-- Background Image -->
            <Image Source="pack://application:,,,/Images/airplane_ticket.png" 
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- Right Panel - Registration Form -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,40,60,40" MaxWidth="400">
                <!-- Registration Header -->
                <TextBlock Text="Đăng Ký Tài Khoản" 
                          FontFamily="Segoe UI"
                          FontSize="28"
                          FontWeight="Bold"
                          Foreground="#333333"
                          Margin="0,0,0,10"
                          HorizontalAlignment="Center"/>
                
                <Image Source="pack://application:,,,/Images/logo.png"
                       Height="40"
                       Margin="0,0,0,30"
                       HorizontalAlignment="Center"/>

                <!-- Email Input -->
                <Grid Margin="0,0,0,15">
                    <TextBox x:Name="txtEmail"
                            Style="{StaticResource ModernTextBox}"
                            Height="45"/>
                    <TextBlock Text="✉" 
                              FontSize="16"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="15,0,0,0"
                              IsHitTestVisible="False"/>
                    <TextBlock Text="Email" 
                              FontFamily="Segoe UI"
                              FontSize="14"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="40,0,0,0"
                              IsHitTestVisible="False"
                              x:Name="txtEmailPlaceholder"/>
                </Grid>

                <!-- Phone Input -->
                <Grid Margin="0,0,0,15">
                    <TextBox x:Name="txtPhone"
                            Style="{StaticResource ModernTextBox}"
                            Height="45"/>
                    <TextBlock Text="📞" 
                              FontSize="16"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="15,0,0,0"
                              IsHitTestVisible="False"/>
                    <TextBlock Text="Số Điện Thoại" 
                              FontFamily="Segoe UI"
                              FontSize="14"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="40,0,0,0"
                              IsHitTestVisible="False"
                              x:Name="txtPhonePlaceholder"/>
                </Grid>

                <!-- Password Input -->
                <Grid Margin="0,0,0,15">
                    <PasswordBox x:Name="txtPassword"
                                Style="{StaticResource ModernPasswordBox}"
                                Height="45"/>
                    <TextBlock Text="🔒" 
                              FontSize="16"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="15,0,0,0"
                              IsHitTestVisible="False"/>
                    <TextBlock Text="Mật khẩu" 
                              FontFamily="Segoe UI"
                              FontSize="14"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="40,0,0,0"
                              IsHitTestVisible="False"
                              x:Name="txtPasswordPlaceholder"/>
                    <Button Content="👁" 
                           Background="Transparent"
                           BorderThickness="0"
                           FontSize="16"
                           Foreground="#999999"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Cursor="Hand"
                           Width="30"
                           Height="30"/>
                </Grid>

                <!-- Confirm Password Input -->
                <Grid Margin="0,0,0,15">
                    <PasswordBox x:Name="txtConfirmPassword"
                                Style="{StaticResource ModernPasswordBox}"
                                Height="45"/>
                    <TextBlock Text="🔒" 
                              FontSize="16"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="15,0,0,0"
                              IsHitTestVisible="False"/>
                    <TextBlock Text="Xác Nhận Mật khẩu" 
                              FontFamily="Segoe UI"
                              FontSize="14"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="40,0,0,0"
                              IsHitTestVisible="False"
                              x:Name="txtConfirmPasswordPlaceholder"/>
                    <Button Content="👁" 
                           Background="Transparent"
                           BorderThickness="0"
                           FontSize="16"
                           Foreground="#999999"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Cursor="Hand"
                           Width="30"
                           Height="30"/>
                </Grid>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <Button Content="Đăng Ký"
                           Style="{StaticResource ModernButton}"
                           Background="#0066FF"
                           Foreground="White"
                           FontSize="15"
                           Height="45"
                           Width="180"
                           Margin="0,0,10,0"/>

                    <Button Content="Hủy"
                           Style="{StaticResource ModernButton}"
                           Background="#FF0000"
                           Foreground="White"
                           FontSize="15"
                           Height="45"
                           Width="180"
                           Click="BtnCancel_Click"/>
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
