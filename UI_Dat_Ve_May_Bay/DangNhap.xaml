<Window x:Class="UI_Dat_Ve_May_Bay.DangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI_Dat_Ve_May_Bay"
        mc:Ignorable="d"
        Title="Đăng Nhập - Parador" 
        Height="600" 
        Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="40,12,12,12"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="40,12,40,12"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Branding -->
        <Grid Grid.Column="0">
            <!-- Background Image -->
            <Image Source="pack://application:,,,/Images/airplane_ticket.png" 
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
            

            

        </Grid>

        <!-- Right Panel - Login Form -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,40,60,40" MaxWidth="400">
                <!-- Login Header -->
                <TextBlock Text="Đăng nhập" 
                          FontFamily="Segoe UI"
                          FontSize="28"
                          FontWeight="Bold"
                          Foreground="#333333"
                          Margin="0,20,0,10"/>
                <TextBlock Text="Vui lòng đăng nhập để tiếp tục" 
                          FontFamily="Segoe UI"
                          FontSize="14"
                          Foreground="#666666"
                          Margin="0,0,0,30"/>

                <!-- Email Input -->
                <Grid Margin="0,0,0,15">
                    <!-- Background Border -->
                    <Border Background="White" 
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="45"/>
                    
                    <!-- Icon -->
                    <TextBlock Text="📧" 
                              FontSize="16"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="15,0,0,0"
                              IsHitTestVisible="False"/>
                    
                    <!-- Placeholder Text -->
                    <TextBlock Text="Email" 
                              FontFamily="Segoe UI"
                              FontSize="14"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="40,0,0,0"
                              IsHitTestVisible="False"
                              x:Name="txtEmailPlaceholder"/>
                    
                    <!-- TextBox with transparent background -->
                    <TextBox x:Name="txtEmail"
                            FontFamily="Segoe UI"
                            FontSize="14"
                            Padding="40,12,12,12"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#333333"
                            VerticalContentAlignment="Center"
                            Height="45"/>
                </Grid>

                <!-- Password Input -->
                <Grid Margin="0,0,0,15">
                    <!-- Background Border -->
                    <Border Background="White" 
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="45"/>
                    
                    <!-- Lock Icon -->
                    <TextBlock Text="🔒" 
                              FontSize="16"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="15,0,0,0"
                              IsHitTestVisible="False"/>
                    
                    <!-- Placeholder Text -->
                    <TextBlock Text="Mật khẩu" 
                              FontFamily="Segoe UI"
                              FontSize="14"
                              Foreground="#999999"
                              VerticalAlignment="Center"
                              Margin="40,0,0,0"
                              IsHitTestVisible="False"
                              x:Name="txtPasswordPlaceholder"/>
                    
                    <!-- PasswordBox with transparent background -->
                    <PasswordBox x:Name="txtPassword"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                Padding="40,12,40,12"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#333333"
                                VerticalContentAlignment="Center"
                                Height="45"
                                PasswordChanged="TxtPassword_PasswordChanged"/>
                    
                    <!-- TextBox for showing password (hidden by default) -->
                    <TextBox x:Name="txtPasswordVisible"
                            FontFamily="Segoe UI"
                            FontSize="14"
                            Padding="40,12,40,12"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#333333"
                            VerticalContentAlignment="Center"
                            Height="45"
                            Visibility="Collapsed"
                            TextChanged="TxtPasswordVisible_TextChanged"/>
                    
                    <!-- Eye Icon Button -->
                    <Button x:Name="btnTogglePassword"
                           Content="👁" 
                           Background="Transparent"
                           BorderThickness="0"
                           FontSize="16"
                           Foreground="#999999"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Cursor="Hand"
                           Width="30"
                           Height="30"
                           Click="BtnTogglePassword_Click"/>
                </Grid>

                <!-- Remember Me & Forgot Password -->
                <Grid Margin="0,0,0,20">
                    <CheckBox Content="Ghi nhớ tài khoản"
                             FontFamily="Segoe UI"
                             FontSize="13"
                             Foreground="#666666"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"/>
                    <TextBlock HorizontalAlignment="Right">
                        <Hyperlink TextDecorations="None" 
                                  Foreground="#0066CC"
                                  FontFamily="Segoe UI"
                                  FontSize="13"
                                  Click="BtnForgotPassword_Click">
                            Quên mật khẩu?
                        </Hyperlink>
                    </TextBlock>
                </Grid>

                <!-- Login Button -->
                <Button Content="Đăng Nhập"
                       Style="{StaticResource ModernButton}"
                       Background="#0066FF"
                       Foreground="White"
                       FontSize="15"
                       Height="45"
                       Margin="0,0,0,15"/>

                <!-- Google Login -->
                <Button Style="{StaticResource ModernButton}"
                       Background="White"
                       Foreground="#666666"
                       FontSize="14"
                       Height="45"
                       Margin="0,0,0,10"
                       BorderThickness="1"
                       BorderBrush="#E0E0E0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                   CornerRadius="8"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   BorderThickness="{TemplateBinding BorderThickness}">
                                <StackPanel Orientation="Horizontal" 
                                          HorizontalAlignment="Center">
                                    <TextBlock Text="G" 
                                             FontWeight="Bold"
                                             FontSize="16"
                                             Foreground="#DB4437"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Đăng nhập với Google"
                                             FontFamily="Segoe UI"
                                             FontSize="14"
                                             Foreground="#666666"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Facebook Login -->
                <Button Style="{StaticResource ModernButton}"
                       Background="#1877F2"
                       Foreground="White"
                       FontSize="14"
                       Height="45"
                       Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="f" 
                                 FontWeight="Bold"
                                 FontSize="18"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Đăng nhập với Facebook"
                                 FontFamily="Segoe UI"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Zalo Login -->
                <Button Style="{StaticResource ModernButton}"
                       Background="#0068FF"
                       Foreground="White"
                       FontSize="14"
                       Height="45"
                       Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" 
                                 FontSize="16"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Đăng nhập qua ứng dụng Zalo"
                                 FontFamily="Segoe UI"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Sign Up Link -->
                <TextBlock HorizontalAlignment="Center"
                          FontFamily="Segoe UI"
                          FontSize="13">
                    <Run Text="Bạn chưa có tài khoản?" Foreground="#666666"/>
                    <Hyperlink TextDecorations="None" 
                              Foreground="#0066CC"
                              FontWeight="SemiBold"
                              Click="BtnRegister_Click">
                        Đăng ký
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
