<UserControl x:Class="UI_Dat_Ve_May_Bay.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Xác thực tài khoản"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Tabs -->
        <Border Grid.Row="1" CornerRadius="10" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
            <TabControl>
                <!-- LOGIN -->
                <TabItem Header="Đăng nhập">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Tài khoản" />
                        <TextBox Grid.Row="1"
                                 Height="36"
                                 Margin="0,6,0,12"
                                 Text="{Binding LoginTaiKhoan, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Text="Mật khẩu" />
                        <PasswordBox x:Name="LoginPasswordBox"
                                     Grid.Row="3"
                                     Height="36"
                                     Margin="0,6,0,12"
                                     PasswordChanged="LoginPasswordBox_PasswordChanged"/>

                        <Button Grid.Row="4"
                                Height="38"
                                Content="Đăng nhập"
                                Command="{Binding LoginCommand}"
                                HorizontalAlignment="Left"
                                Width="140"/>

                        <!-- ✅ Social login -->
                        <StackPanel Grid.Row="5" Margin="0,14,0,0">
                            <TextBlock Text="Hoặc đăng nhập bằng:" Foreground="#666" Margin="0,0,0,10"/>

                            <WrapPanel>
                                <Button Height="38" Width="210" Margin="0,0,10,10"
                                        Content="🔵 Google"
                                        Command="{Binding LoginGoogleCommand}"/>

                                <Button Height="38" Width="210" Margin="0,0,10,10"
                                        Content="🔷 Facebook"
                                        Command="{Binding LoginFacebookCommand}"/>

                                <Button Height="38" Width="210" Margin="0,0,10,10"
                                        Content="🟦 Zalo"
                                        Command="{Binding LoginZaloCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- REGISTER -->
                <TabItem Header="Đăng ký">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Tài khoản" />
                            <TextBox Grid.Row="1" Height="36" Margin="0,6,0,12"
                                     Text="{Binding RegTaiKhoan, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Text="Email" />
                            <TextBox Grid.Row="3" Height="36" Margin="0,6,0,12"
                                     Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Text="Họ tên (nếu có)" />
                            <TextBox Grid.Row="5" Height="36" Margin="0,6,0,12"
                                     Text="{Binding RegHoTen, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Text="SĐT (nếu có)" />
                            <TextBox Grid.Row="7" Height="36" Margin="0,6,0,12"
                                     Text="{Binding RegSoDienThoai, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,0,0,12">
                                <StackPanel Width="240" Margin="0,0,12,0">
                                    <TextBlock Text="Mật khẩu" />
                                    <PasswordBox x:Name="RegPasswordBox"
                                                 Height="36" Margin="0,6,0,0"
                                                 PasswordChanged="RegPasswordBox_PasswordChanged"/>
                                </StackPanel>

                                <StackPanel Width="240">
                                    <TextBlock Text="Xác nhận mật khẩu" />
                                    <PasswordBox x:Name="RegConfirmPasswordBox"
                                                 Height="36" Margin="0,6,0,0"
                                                 PasswordChanged="RegConfirmPasswordBox_PasswordChanged"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Row="9"
                                    Height="38"
                                    Content="Đăng ký"
                                    Command="{Binding RegisterCommand}"
                                    HorizontalAlignment="Left"
                                    Width="140"/>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- FORGOT PASSWORD -->
                <TabItem Header="Quên mật khẩu">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Step 1: Email -->
                        <StackPanel Grid.Row="0"
                                    Visibility="{Binding IsStepEmail, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Email" />
                            <TextBox Height="36" Margin="0,6,0,12"
                                     Text="{Binding FpEmail, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Height="38" Width="180" HorizontalAlignment="Left"
                                    Content="Gửi OTP"
                                    Command="{Binding SendOtpCommand}"/>
                        </StackPanel>

                        <!-- Step 2: OTP -->
                        <StackPanel Grid.Row="1"
                                    Visibility="{Binding IsStepOtp, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nhập OTP" />
                            <TextBox Height="36" Margin="0,6,0,12"
                                     Text="{Binding FpOtp, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Height="38" Width="180" HorizontalAlignment="Left"
                                    Content="Xác nhận OTP"
                                    Command="{Binding VerifyOtpCommand}"/>
                        </StackPanel>

                        <!-- Step 3: Reset -->
                        <StackPanel Grid.Row="2"
                                    Visibility="{Binding IsStepReset, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Mật khẩu mới" />
                            <PasswordBox x:Name="FpNewPasswordBox"
                                         Height="36" Margin="0,6,0,12"
                                         PasswordChanged="FpNewPasswordBox_PasswordChanged"/>

                            <TextBlock Text="Xác nhận mật khẩu" />
                            <PasswordBox x:Name="FpConfirmPasswordBox"
                                         Height="36" Margin="0,6,0,12"
                                         PasswordChanged="FpConfirmPasswordBox_PasswordChanged"/>

                            <Button Height="38" Width="180" HorizontalAlignment="Left"
                                    Content="Đổi mật khẩu"
                                    Command="{Binding ResetPasswordCommand}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Status -->
        <Border Grid.Row="2" CornerRadius="8" BorderBrush="#EEEEEE" BorderThickness="1" Padding="10" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
