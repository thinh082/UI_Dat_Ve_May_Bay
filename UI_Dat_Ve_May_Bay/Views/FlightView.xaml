<!-- FlightView.xaml -->
<UserControl x:Class="UI_Dat_Ve_May_Bay.Views.FlightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF3F4F6"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FF16A34A"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <!-- Show element when bound boolean == true -->
        <Style x:Key="ShowWhenTrue" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top search box -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#FFE5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: main search -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Sân bay đi" Foreground="#FF6B7280" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding Airports}"
                                  SelectedItem="{Binding SelectedFromAirport}"
                                  DisplayMemberPath="Code"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Code"
                                  Text="{Binding MaSanBayDi, UpdateSourceTrigger=PropertyChanged}"
                                  Height="34" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="⇄"
                            Command="{Binding SwapAirportsCommand}"
                            Width="40"
                            Height="34"
                            Margin="0,18,10,0"
                            Background="#FFF3F4F6"
                            Foreground="#FF111827"
                            BorderBrush="#FFE5E7EB"
                            Cursor="Hand"/>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Sân bay đến" Foreground="#FF6B7280" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding Airports}"
                                  SelectedItem="{Binding SelectedToAirport}"
                                  DisplayMemberPath="Code"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Code"
                                  Text="{Binding MaSanBayDen, UpdateSourceTrigger=PropertyChanged}"
                                  Height="34" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Ngày đi" Foreground="#FF6B7280" FontSize="12"/>
                        <DatePicker SelectedDate="{Binding NgayDi, Mode=TwoWay}"
                                    Height="34" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Command="{Binding SearchCommand}"
                            Margin="0,18,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="Tìm chuyến bay"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Content" Value="Đang tìm..."/>
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Row 2: extra filters -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top">

                    <!-- Loading lookup label -->
                    <TextBlock Text="Đang tải danh mục..."
                               Foreground="#FF6B7280"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource ShowWhenTrue}"
                               DataContext="{Binding IsLookupLoading}"/>

                    <StackPanel Margin="0,0,12,0" Width="220">
                        <TextBlock Text="Hãng bay" Foreground="#FF6B7280" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding Airlines}"
                                  SelectedItem="{Binding SelectedAirline}"
                                  DisplayMemberPath="Name"
                                  Height="34" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0" Width="220">
                        <TextBlock Text="Tiện nghi" Foreground="#FF6B7280" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding Amenities}"
                                  SelectedItem="{Binding SelectedAmenity}"
                                  DisplayMemberPath="Name"
                                  Height="34" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0" Width="140">
                        <TextBlock Text="Giá min" Foreground="#FF6B7280" FontSize="12"/>
                        <TextBox Text="{Binding GiaMin, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0" Width="140">
                        <TextBlock Text="Giá max" Foreground="#FF6B7280" FontSize="12"/>
                        <TextBox Text="{Binding GiaMax, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0" Width="180">
                        <TextBlock Text="Sắp xếp" Foreground="#FF6B7280" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}"
                                  Height="34" Margin="0,6,0,0"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#FFE5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Summary -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Kết quả:" FontWeight="SemiBold" Foreground="#FF111827"/>
                    <TextBlock Text="{Binding SelectedSummary}" Margin="8,0,0,0" Foreground="#FF6B7280"/>
                    <Border Margin="10,0,0,0"
                            Background="#FFF3F4F6"
                            BorderBrush="#FFE5E7EB"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="10,4">
                        <TextBlock Text="{Binding Results.Count}" Foreground="#FF111827"/>
                    </Border>
                </StackPanel>

                <!-- Empty state (no converter) -->
                <Border Grid.Row="2"
                        Background="Transparent"
                        Style="{StaticResource ShowWhenTrue}"
                        DataContext="{Binding ShowEmptyState}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Không có dữ liệu"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FF111827"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Hãy thử đổi tiêu chí tìm kiếm."
                                   Foreground="#FF6B7280"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Results list -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFE5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF111827"
                                                   FontSize="14"/>

                                        <ItemsControl ItemsSource="{Binding Schedules}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#FFE5E7EB"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="10"
                                                            Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding DisplayTime}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#FF111827"/>
                                                                <TextBlock Text="{Binding ThoiGianBay, StringFormat={}{0} phút}"
                                                                           Foreground="#FF6B7280"
                                                                           FontSize="12"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding DisplayPrice}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#FF111827"/>
                                                                <TextBlock Text="{Binding SoLuongGhe, StringFormat={}{0} ghế}"
                                                                           Foreground="#FF6B7280"
                                                                           FontSize="12"/>
                                                            </StackPanel>

                                                            <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <Border Style="{StaticResource ChipStyle}">
                                                                    <TextBlock Text="{Binding MaSanBayDi}"
                                                                               Foreground="#FF111827"
                                                                               FontWeight="SemiBold"/>
                                                                </Border>

                                                                <Border Style="{StaticResource ChipStyle}">
                                                                    <TextBlock Text="{Binding MaSanBayDen}"
                                                                               Foreground="#FF111827"
                                                                               FontWeight="SemiBold"/>
                                                                </Border>

                                                                <!-- Hide when empty/null without converter & without duplicate Style -->
                                                                <Border>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding TienIchText}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding TienIchText}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding TienIchText}" Foreground="#FF111827"/>
                                                                </Border>
                                                            </WrapPanel>

                                                            <Button Grid.Column="3"
                                                                    Content="Chọn"
                                                                    Command="{Binding DataContext.SelectScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SuccessButton}"
                                                                    VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>