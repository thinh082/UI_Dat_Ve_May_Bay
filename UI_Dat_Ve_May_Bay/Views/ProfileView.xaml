<UserControl x:Class="UI_Dat_Ve_May_Bay.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#FFF3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFF9FAFB"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#FFF9FAFB"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RoundedDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#FFF9FAFB"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,12" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Hồ sơ khách hàng" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Cập nhật thông tin cơ bản, CCCD và Passport để hoàn thiện hồ sơ hành khách."
                               Margin="0,6,0,0" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding Status}" Margin="0,8,0,0" Foreground="#2563EB" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Error}" Margin="0,4,0,0" Foreground="#DC2626" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Tải lại" Style="{StaticResource GhostBtn}" Command="{Binding LoadAllCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left main form -->
            <TabControl Grid.Column="0">
                <!-- Thong tin co ban -->
                <TabItem Header="Thông tin cơ bản">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" Margin="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Họ tên" Style="{StaticResource InputLabel}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding TenKh, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Email" Style="{StaticResource InputLabel}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Số điện thoại" Style="{StaticResource InputLabel}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Giới tính" Style="{StaticResource InputLabel}"/>
                                        <ComboBox Style="{StaticResource RoundedCombo}" SelectedValue="{Binding GioiTinh}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Nam" Tag="1"/>
                                            <ComboBoxItem Content="Nữ" Tag="0"/>
                                            <ComboBoxItem Content="Khác / Chưa rõ" Tag="2"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Số nhà" Style="{StaticResource InputLabel}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding SoNha, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tỉnh" Style="{StaticResource InputLabel}"/>
                                        <ComboBox Style="{StaticResource RoundedCombo}"
                                                  ItemsSource="{Binding TinhOptions}"
                                                  DisplayMemberPath="Ten"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding IdTinh, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding HasTinhOptions, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}"
                                                 Text="{Binding IdTinh, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding NoTinhOptions, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Quận/Huyện" Style="{StaticResource InputLabel}"/>
                                        <ComboBox Style="{StaticResource RoundedCombo}"
                                                  ItemsSource="{Binding QuanOptions}"
                                                  DisplayMemberPath="Ten"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding IdQuan, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding HasQuanOptions, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}"
                                                 Text="{Binding IdQuan, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding NoQuanOptions, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Phường/Xã" Style="{StaticResource InputLabel}"/>
                                        <ComboBox Style="{StaticResource RoundedCombo}"
                                                  ItemsSource="{Binding PhuongOptions}"
                                                  DisplayMemberPath="Ten"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding IdPhuong, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding HasPhuongOptions, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}"
                                                 Text="{Binding IdPhuong, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding NoPhuongOptions, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Quốc tịch" Style="{StaticResource InputLabel}"/>
                                        <ComboBox Style="{StaticResource RoundedCombo}"
                                                  ItemsSource="{Binding QuocTichOptions}"
                                                  DisplayMemberPath="Ten"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding IdQuocTich, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding HasQuocTichOptions, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}"
                                                 Text="{Binding IdQuocTich, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding NoQuocTichOptions, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="3" Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <DockPanel>
                                        <TextBlock Text="Nếu BE expose file danh mục (Tinh/Quan/Phuong/QuocTich.json) thì app sẽ dùng dropdown. Nếu không, bạn vẫn có thể nhập ID tay."
                                                   Foreground="#6B7280" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Tải danh mục" Style="{StaticResource GhostBtn}" Command="{Binding LoadConfigCommand}"/>
                                            <Button Content="Lưu thông tin cơ bản" Style="{StaticResource PrimaryBtn}" Command="{Binding SaveBasicCommand}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- CCCD -->
                <TabItem Header="CCCD">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" Margin="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Số CCCD" Style="{StaticResource InputLabel}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding SoCccd, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Tên trên CCCD" Style="{StaticResource InputLabel}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding TenTrenCccd, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <TextBlock Text="Nơi thường trú" Style="{StaticResource InputLabel}"/>
                                    <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding NoiThuongTru, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Quê quán" Style="{StaticResource InputLabel}"/>
                                    <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding QueQuan, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Lưu CCCD" Style="{StaticResource PrimaryBtn}" Command="{Binding SaveCccdCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- Passport -->
                <TabItem Header="Passport">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" Margin="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Số Passport" Style="{StaticResource InputLabel}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding SoPassport, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Tên trên Passport" Style="{StaticResource InputLabel}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding TenTrenPassport, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nơi cấp" Style="{StaticResource InputLabel}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding NoiCap, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ngày cấp" Style="{StaticResource InputLabel}"/>
                                        <DatePicker Style="{StaticResource RoundedDatePicker}" SelectedDate="{Binding NgayCap}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Ngày hết hạn" Style="{StaticResource InputLabel}"/>
                                        <DatePicker Style="{StaticResource RoundedDatePicker}" SelectedDate="{Binding NgayHetHan}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Quốc tịch (text)" Style="{StaticResource InputLabel}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding PassportQuocTich, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Loại Passport" Style="{StaticResource InputLabel}"/>
                                        <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding LoaiPassport, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="3">
                                    <TextBlock Text="Ghi chú" Style="{StaticResource InputLabel}"/>
                                    <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding GhiChuPassport, UpdateSourceTrigger=PropertyChanged}" Height="70" VerticalContentAlignment="Top" AcceptsReturn="True" Padding="10"/>
                                    <Button Content="Lưu Passport" Style="{StaticResource PrimaryBtn}" Command="{Binding SavePassportCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Right summary card -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Tổng quan hồ sơ" FontSize="18" FontWeight="Bold" Foreground="#111827"/>

                        <Border Margin="0,12,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Thông tin cơ bản" FontWeight="Bold" Foreground="#1D4ED8"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding TenKh}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Email}" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding SoDienThoai}" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="CCCD" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding SoCccd}"/>
                                <TextBlock Text="{Binding TenTrenCccd}" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0" Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Passport" FontWeight="Bold" Foreground="#7C3AED"/>
                                <TextBlock Margin="0,8,0,0" Text="{Binding SoPassport}"/>
                                <TextBlock Text="{Binding TenTrenPassport}" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding LoaiPassport}" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Avatar URL (read-only)" FontWeight="SemiBold"/>
                                <TextBox Margin="0,8,0,0" Style="{StaticResource RoundedTextBox}" Text="{Binding AvatarUrl}" IsReadOnly="True"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#6B7280" Text="Ghi chú: Upload avatar có API riêng (UpAvatar). Có thể làm thêm sau nếu bạn muốn." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
