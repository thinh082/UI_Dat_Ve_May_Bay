<UserControl x:Class="UI_Dat_Ve_May_Bay.Views.VoucherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:UI_Dat_Ve_May_Bay.Core"
             Background="White">

    <UserControl.Resources>
        <core:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter"/>

        <!-- Button style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Small chip style -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="Background" Value="#FFF9FAFB"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Voucher" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Tìm và áp dụng mã giảm giá cho tài khoản của bạn."
                       Foreground="#FF6B7280" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Search + List -->
            <Border Grid.Column="0"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="#FFE5E7EB"
                    Background="#FFFFFFFF"
                    Padding="14"
                    Margin="0,0,12,0">

                <DockPanel LastChildFill="True">

                    <!-- Top controls -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Status}" Foreground="#FF6B7280" Margin="0,0,0,10"/>

                        <!-- Search box -->
                        <Border CornerRadius="12" BorderThickness="1" BorderBrush="#FFE5E7EB" Background="#FFF9FAFB" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Height="28"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding SearchCode, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13"
                                         Foreground="#FF111827"/>

                                <Button Grid.Column="1"
                                        Content="Tìm"
                                        Style="{StaticResource PrimaryBtn}"
                                        Command="{Binding SearchCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Actions -->
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Voucher của tôi"
                                    Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding LoadMyVouchersCommand}"/>

                            <Button Content="Tất cả voucher"
                                    Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding LoadAllVouchersCommand}"/>

                            <Button Content="Chi tiết"
                                    Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding LoadDetailsCommand}"/>

                            <Button Content="Apply"
                                    Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding ApplySelectedCommand}"/>
                        </WrapPanel>

                        <Separator Margin="0,10,0,10"/>
                    </StackPanel>

                    <!-- List -->
                    <ListBox ItemsSource="{Binding Vouchers}"
         SelectedItem="{Binding SelectedVoucher}"
         BorderThickness="0"
         Background="Transparent"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <!-- QUAN TRỌNG: item stretch full width -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <!-- Tắt highlight xanh lè -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Card full width -->
                                <Border x:Name="Card"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#FFE5E7EB"
                    Background="#FFFFFFFF"
                    Padding="12"
                    Height="92">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayCode}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="#FF111827"
                                   TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#FF6B7280">
                            <Run Text="{Binding DisplayValue}"/>
                            <Run Text="  •  Hạn: "/>
                            <Run Text="{Binding DisplayExpiry}"/>
                                            </TextBlock>

                                            <TextBlock Text="{Binding DisplayContent}"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="#FF6B7280"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="32"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                            CornerRadius="10"
                            Padding="10,4"
                            BorderThickness="1"
                            BorderBrush="#FFE5E7EB"
                            Background="#FFF9FAFB"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Active, Converter={StaticResource BoolToStatusTextConverter}}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FF111827"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Khi Selected: đổi viền + nền nhẹ (không còn xanh nguyên mảng) -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                             Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="#FF93C5FD"/>
                                        <Setter TargetName="Card" Property="Background" Value="#FFF0F9FF"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: Detail -->
            <Border Grid.Column="1"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="#FFE5E7EB"
                    Background="#FFFFFFFF"
                    Padding="16">

                <StackPanel>
                    <TextBlock Text="Chi tiết voucher" FontSize="18" FontWeight="Bold"/>

                    <Border CornerRadius="14"
                            BorderThickness="1"
                            BorderBrush="#FFE5E7EB"
                            Background="#FFF9FAFB"
                            Padding="14"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedVoucher.DisplayCode}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FF111827"/>

                            <TextBlock Text="{Binding SelectedVoucher.DisplayContent}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#FF6B7280"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Giảm:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedVoucher.DisplayValue}" Margin="8,0,0,0"/>

                                <TextBlock Grid.Column="2" Text="Hết hạn:" FontWeight="SemiBold" Margin="18,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding SelectedVoucher.DisplayExpiry}" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Loại:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedVoucher.LoaiGiamGia}" Margin="8,0,0,0"/>

                                <TextBlock Grid.Column="2" Text="Trạng thái:" FontWeight="SemiBold" Margin="18,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding SelectedVoucher.Active, Converter={StaticResource BoolToStatusTextConverter}}" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Chọn 1 voucher bên trái để xem chi tiết."
                               Margin="0,12,0,0"
                               Foreground="#FF6B7280"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
